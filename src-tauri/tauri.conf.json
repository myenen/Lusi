{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lusi",
  "version": "0.1.0",
  "identifier": "dev.minimalmail.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lusi",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 },
        "width": 1260,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "ui-preferences",
          "windows": ["main"],
          "permissions": ["allow-load-ui-preferences", "allow-save-ui-preferences"]
        },
        {
          "identifier": "macos-titlebar",
          "platforms": ["macOS"],
          "windows": ["main"],
          "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
